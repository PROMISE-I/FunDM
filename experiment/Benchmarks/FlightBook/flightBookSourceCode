        [ noBorder, backgroundColor blue, color white
        , padding 20, fontSize 24, fontWeight 700
        ],

    sectionStyle = 
        [ margin 5, padding 20, backgroundColor lightGray
        , borderRadius 5
        ],

    inputStyle = 
        [ width 200, height 30, lineHeight 30, borderRadius 3,
          marginRight 10, marginBottom 10, padding 5, fontSize 14
